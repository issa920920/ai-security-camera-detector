# Copy this file to .env and fill in your own values.
# .env is ignored by git, so your passwords stay off GitHub.
# lookup how to write your password in RTSP format if it has any symbols in it!
RTSP_URL=rtsp://USERNAME:PASSWORD@CAMERA_IP:554/h264Preview_02_sub
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id
TARGET_CLASS=car
COOLDOWN_SECONDS=30
